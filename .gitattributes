# 统一用 LF。CRLF 会让 shebang 变成 "#!/system/bin/sh\r", 脚本直接跑不起来。
* text=auto eol=lf

*.sh   text eol=lf
*.cgi  text eol=lf
*.prop text eol=lf
*.conf text eol=lf
*.html text eol=lf
*.js   text eol=lf
*.css  text eol=lf
*.md   text eol=lf
*.json text eol=lf

# bin/ 与 system/bin/ 下是无扩展名的可执行脚本
cpuctl   text eol=lf
